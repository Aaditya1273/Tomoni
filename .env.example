# Copy to .env. Values here are local-dev placeholders only; never commit real secrets.
NODE_ENV=development

# Database (owner runs migrations; app/worker/sponsor are RLS-enforced roles)
DATABASE_OWNER_URL=postgres://tomoni_owner:dev_owner_pw@127.0.0.1:5544/tomoni
DATABASE_URL=postgres://tomoni_app:dev_app_pw@127.0.0.1:5544/tomoni
DATABASE_WORKER_URL=postgres://tomoni_worker:dev_worker_pw@127.0.0.1:5544/tomoni
DATABASE_SPONSOR_URL=postgres://tomoni_sponsor:dev_sponsor_pw@127.0.0.1:5544/tomoni
REDIS_URL=redis://127.0.0.1:6390

# Field encryption keyring: "<keyId>:<base64 32 bytes>[,<keyId>:<base64>...]". First key encrypts.
# Generate: node -e "console.log('k1:'+require('crypto').randomBytes(32).toString('base64'))"
TOMONI_FIELD_KEYS=k1:REPLACE_ME_WITH_32_BYTES_BASE64
TOMONI_HMAC_KEY=REPLACE_ME_WITH_32_BYTES_BASE64
TOMONI_SESSION_SECRET=REPLACE_ME_WITH_32_BYTES_BASE64

# Real-data kill switch (SECURITY S17). Must stay false until GO_LIVE_CHECKLIST is complete.
TOMONI_REAL_DATA_ENABLED=false

# Adapters: real | mock
TOMONI_ADAPTER_TELEPHONY=mock
TOMONI_ADAPTER_SPEECH=mock
TOMONI_ADAPTER_LLM=mock
TOMONI_ADAPTER_BLUEBUTTON=mock
# Blue Button sandbox app credentials (https://sandbox.bluebutton.cms.gov), used when the adapter is "real".
# TOMONI_BB_CLIENT_ID=
# TOMONI_BB_CLIENT_SECRET=

# Twilio (TOMONI_ADAPTER_TELEPHONY=real). Calls real people: also requires TOMONI_REAL_DATA_ENABLED=true.
# TOMONI_TWILIO_ACCOUNT_SID=
# TOMONI_TWILIO_AUTH_TOKEN=
# TOMONI_TWILIO_FROM=+1...
# TOMONI_PUBLIC_API_ORIGIN=https://api.example   # where Twilio sends webhooks
# Daily call scheduler (every 5 minutes). Off by default: on means dialing patients.
# TOMONI_CALL_SCHEDULER=on
# Conversation LLM (TOMONI_ADAPTER_LLM=real): Anthropic credentials as usual; model override:
# TOMONI_LLM_MODEL=claude-opus-5-5

# Pin "today" for the warning engine and synthetic data (tests and demos). Unset = the real date.
# TOMONI_TODAY=2026-11-15

# Ports
API_PORT=4000
WEB_PORT=3000
SPONSOR_PORT=3100
